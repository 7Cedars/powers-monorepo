# Project Orange — environment variables
# Copy this file to .env.local and fill in the values.
# Never commit .env.local to git.

# RPC endpoints (required for live-network deployment)
SEPOLIA_RPC_URL=
ARB_SEPOLIA_RPC_URL=
OPT_SEPOLIA_RPC_URL=

# Etherscan API key (required for contract verification on Arb/Opt Sepolia)
ETHERSCAN_API_KEY=

# Foundry encrypted keystore (created with: cast wallet import my-wallet --interactive)
DEPLOYER_ACCOUNT=my-wallet
DEPLOYER_ADDRESS=0x0000000000000000000000000000000000000000

# After deployment: fill in these values for use in the Actions and Runners scripts
POWERS_ADDRESS=
PAYMASTER_ADDRESS=
