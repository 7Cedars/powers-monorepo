[submodule "solidity/lib/zkpassport-packages"]
	path = solidity/lib/zkpassport-packages
	url = https://github.com/zkpassport/zkpassport-packages
	shallow = true
	fetchRecurseSubmodules = false
[submodule "solidity/lib/circuits"]
	path = solidity/lib/circuits
	url = https://github.com/zkpassport/circuits
[submodule "solidity/lib/account-abstraction"]
	path = solidity/lib/account-abstraction
	url = https://github.com/eth-infinitism/account-abstraction
